# Copy to terraform.tfvars (git-ignored) and fill in what you need; every line is optional.

# name     = "kickstream"
# location = "centralindia"

# Entra object IDs of other people who may open the studio (co-hosts sign in too):
#   az ad user show --id someone@example.com --query id -o tsv
# studio_users = ["00000000-0000-0000-0000-000000000000"]

# api_football_key = ""
# llm_base_url     = "https://<resource>.openai.azure.com/openai/v1/"
# llm_model        = "gpt-4.1-mini"
# llm_api_key      = ""

# Or a Microsoft Foundry project, signed in to with the app's managed identity; used instead of llm_*.
# foundry_project_endpoint = "https://<resource>.services.ai.azure.com/api/projects/<project>"
# foundry_deployment       = "gpt-4.1-mini"
# foundry_resource_id      = "/subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<resource>"

# Auto live (/live): on at first start; Azure Speech tier and daily character allowance for its voice.
# autolive           = true
# public_view        = true  # anyone may watch /live and /match, read-only; false puts them behind sign-in too
# real_sources       = false # true adds StatsBomb, API-Football and OpenLigaDB beside the synthetic match
# speech_sku         = "S0"
# speech_daily_chars = 200000
