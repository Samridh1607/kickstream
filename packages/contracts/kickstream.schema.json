{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KickstreamContracts",
  "$defs": {
    "Player": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "number", "position"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "number": { "type": "integer" },
        "position": { "enum": ["GK", "DF", "MF", "FW"] }
      }
    },
    "TeamSheet": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "short_name", "color", "players"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "short_name": { "type": "string" },
        "color": { "type": "string" },
        "players": { "type": "array", "items": { "$ref": "#/$defs/Player" } }
      }
    },
    "MatchStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["match_id", "state", "minute", "score_home", "score_away", "speed", "home", "away"],
      "properties": {
        "match_id": { "type": "string" },
        "state": { "enum": ["live", "half_time", "finished", "abandoned"] },
        "minute": { "type": "integer" },
        "score_home": { "type": "integer" },
        "score_away": { "type": "integer" },
        "speed": { "type": "number" },
        "home": { "$ref": "#/$defs/TeamSheet" },
        "away": { "$ref": "#/$defs/TeamSheet" }
      }
    },
    "MatchEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "match_id", "seq", "minute", "second", "type", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "match_id": { "type": "string" },
        "seq": { "type": "integer" },
        "minute": { "type": "integer" },
        "second": { "type": "integer" },
        "type": { "enum": ["kickoff", "pass", "shot", "goal", "save", "foul", "yellow_card", "red_card", "corner", "substitution", "half_time", "full_time"] },
        "team": { "enum": ["home", "away", null], "default": null },
        "player_id": { "type": ["string", "null"], "default": null },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "outcome": { "enum": ["goal", "saved", "off_target", "blocked", null], "default": null },
        "completed": { "type": ["boolean", "null"], "default": null },
        "player_in_id": { "type": ["string", "null"], "default": null }
      }
    },
    "TeamStats": {
      "type": "object", "additionalProperties": false,
      "required": ["goals", "possession", "shots", "shots_on_target", "passes", "pass_accuracy", "fouls", "yellow_cards", "red_cards", "xg"],
      "properties": {
        "goals": { "type": "integer" },
        "possession": { "type": "number" },
        "shots": { "type": "integer" },
        "shots_on_target": { "type": "integer" },
        "passes": { "type": "integer" },
        "pass_accuracy": { "type": "number" },
        "fouls": { "type": "integer" },
        "yellow_cards": { "type": "integer" },
        "red_cards": { "type": "integer" },
        "xg": { "type": "number" }
      }
    },
    "StatsSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "match_id", "minute", "home", "away", "momentum"],
      "properties": {
        "id": { "type": "string" },
        "match_id": { "type": "string" },
        "minute": { "type": "integer" },
        "home": { "$ref": "#/$defs/TeamStats" },
        "away": { "$ref": "#/$defs/TeamStats" },
        "momentum": { "type": "number" },
        "period_end": { "enum": ["half_time", "full_time", null], "default": null }
      }
    },
    "PressureSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "match_id", "minute", "cols", "rows", "home", "away"],
      "properties": {
        "id": { "type": "string" },
        "match_id": { "type": "string" },
        "minute": { "type": "integer" },
        "cols": { "type": "integer" },
        "rows": { "type": "integer" },
        "home": { "type": "array", "items": { "type": "number" } },
        "away": { "type": "array", "items": { "type": "number" } }
      }
    },
    "StatFact": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "enum": ["xg", "shots", "shots_on_target", "possession", "pressure", "momentum", "players_on_pitch", "fouls"] },
        "value": { "type": "number" }
      }
    },
    "KeyMoment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "match_id", "minute", "kind", "team", "score_home", "score_away", "facts"],
      "properties": {
        "id": { "type": "string" },
        "match_id": { "type": "string" },
        "minute": { "type": "integer" },
        "kind": { "enum": ["goal", "red_card", "big_chance", "momentum_swing", "sustained_pressure"] },
        "team": { "enum": ["home", "away"] },
        "player_id": { "type": ["string", "null"], "default": null },
        "event_id": { "type": ["string", "null"], "default": null },
        "score_home": { "type": "integer" },
        "score_away": { "type": "integer" },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/StatFact" } }
      }
    },
    "Narrative": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "match_id", "minute", "moment_id", "mode", "language", "text", "source", "agent", "evidence", "team"],
      "properties": {
        "id": { "type": "string" },
        "match_id": { "type": "string" },
        "minute": { "type": "integer" },
        "moment_id": { "type": "string" },
        "mode": { "enum": ["fan", "analyst"] },
        "language": { "enum": ["en", "es", "hi"] },
        "text": { "type": "string", "minLength": 1 },
        "source": { "enum": ["agent", "scripted"] },
        "agent": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "team": { "enum": ["home", "away"] },
        "player_id": { "type": ["string", "null"], "default": null }
      }
    },
    "Recap": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "match_id", "minute", "period", "mode", "language", "title", "bullets", "text", "source", "agent", "score_home", "score_away"],
      "properties": {
        "id": { "type": "string" },
        "match_id": { "type": "string" },
        "minute": { "type": "integer" },
        "period": { "enum": ["half_time", "full_time"] },
        "mode": { "enum": ["fan", "analyst"] },
        "language": { "enum": ["en", "es", "hi"] },
        "title": { "type": "string", "minLength": 1 },
        "bullets": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 },
        "text": { "type": "string", "minLength": 1 },
        "source": { "enum": ["agent", "scripted"] },
        "agent": { "type": "string" },
        "score_home": { "type": "integer" },
        "score_away": { "type": "integer" }
      }
    },
    "LowerThirdData": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "subline", "team", "minute"],
      "properties": {
        "headline": { "type": "string" },
        "subline": { "type": "string" },
        "team": { "type": "string" },
        "minute": { "type": "integer" }
      }
    },
    "StatRow": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "home", "away"],
      "properties": {
        "label": { "type": "string" },
        "home": { "type": "number" },
        "away": { "type": "number" }
      }
    },
    "StatCardData": {
      "type": "object", "additionalProperties": false,
      "required": ["stat_rows"],
      "properties": {
        "stat_rows": { "type": "array", "items": { "$ref": "#/$defs/StatRow" }, "maxItems": 4 }
      }
    },
    "PressureMapData": {
      "type": "object", "additionalProperties": false,
      "required": ["cols", "rows", "home", "away"],
      "properties": {
        "cols": { "type": "integer" },
        "rows": { "type": "integer" },
        "home": { "type": "array", "items": { "type": "number" } },
        "away": { "type": "array", "items": { "type": "number" } }
      }
    },
    "RecapCardData": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "score", "bullets"],
      "properties": {
        "title": { "type": "string" },
        "score": { "type": "string" },
        "bullets": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
      }
    },
    "Overlay": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "match_id", "minute", "kind", "duration_ms", "sources", "data"],
      "properties": {
        "id": { "type": "string" },
        "match_id": { "type": "string" },
        "minute": { "type": "integer" },
        "kind": { "enum": ["lower_third", "stat_card", "pressure_map", "recap_card"] },
        "language": { "enum": ["en", "es", "hi", null], "default": null },
        "duration_ms": { "type": "integer" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "data": {
          "anyOf": [
            { "$ref": "#/$defs/LowerThirdData" },
            { "$ref": "#/$defs/StatCardData" },
            { "$ref": "#/$defs/PressureMapData" },
            { "$ref": "#/$defs/RecapCardData" }
          ]
        }
      }
    },
    "ViewerProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "language"],
      "properties": {
        "mode": { "enum": ["fan", "analyst"] },
        "language": { "enum": ["en", "es", "hi"] },
        "club": { "type": ["string", "null"], "default": null },
        "player": { "type": ["string", "null"], "default": null }
      }
    },
    "Envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "match_id", "minute", "highlighted", "payload"],
      "properties": {
        "id": { "type": "integer" },
        "type": { "enum": ["match_status", "match_event", "stats", "pressure", "key_moment", "narrative", "recap", "overlay"] },
        "match_id": { "type": "string" },
        "minute": { "type": "integer" },
        "highlighted": { "type": "boolean" },
        "payload": { "type": "object" }
      }
    },
    "SceneElement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "x", "y", "width", "height", "layer", "visible", "props"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "enum": ["scoreboard", "pitch", "narration", "stats", "banner", "ticker", "timeline", "recap", "replay", "countdown", "text", "image"] },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "layer": { "type": "integer" },
        "visible": { "type": "boolean" },
        "props": { "type": "object" }
      }
    },
    "Scene": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "elements"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "template": { "type": ["string", "null"], "default": null },
        "mode": { "enum": ["fan", "analyst", null], "default": null },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/SceneElement" }, "maxItems": 40 }
      }
    },
    "StudioSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "language", "auto_banner", "auto_start", "auto_half_time_break"],
      "properties": {
        "mode": { "enum": ["fan", "analyst"] },
        "language": { "enum": ["en", "es", "hi"] },
        "auto_banner": { "type": "boolean" },
        "auto_start": { "type": "boolean" },
        "auto_half_time_break": { "type": "boolean" }
      }
    },
    "Banner": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "kind", "duration_s"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["goal", "card", "info", "custom"] },
        "duration_s": { "type": "integer", "minimum": 3, "maximum": 30 },
        "ends_at": { "type": ["number", "null"], "default": null },
        "source_id": { "type": ["string", "null"], "default": null }
      }
    },
    "Ticker": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "speed", "messages", "show_score", "show_stats"],
      "properties": {
        "enabled": { "type": "boolean" },
        "speed": { "type": "integer", "minimum": 40, "maximum": 400 },
        "messages": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "show_score": { "type": "boolean" },
        "show_stats": { "type": "boolean" }
      }
    },
    "Countdown": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "ends_at", "label"],
      "properties": {
        "kind": { "enum": ["start", "break"] },
        "ends_at": { "type": "number" },
        "label": { "type": "string", "maxLength": 60 }
      }
    },
    "Replay": {
      "type": "object", "additionalProperties": false,
      "required": ["match_id", "moment_id", "minute", "started_at", "duration_s"],
      "properties": {
        "match_id": { "type": "string" },
        "moment_id": { "type": "string" },
        "minute": { "type": "integer" },
        "started_at": { "type": "number" },
        "duration_s": { "type": "number" }
      }
    },
    "Studio": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "server_time", "scenes", "active_scene_id", "templates", "settings", "banner_queue", "ticker"],
      "properties": {
        "revision": { "type": "integer" },
        "server_time": { "type": "number" },
        "scenes": { "type": "array", "items": { "$ref": "#/$defs/Scene" }, "minItems": 1, "maxItems": 20 },
        "active_scene_id": { "type": "string" },
        "previous_scene_id": { "type": ["string", "null"], "default": null },
        "templates": { "type": "array", "items": { "$ref": "#/$defs/Scene" }, "maxItems": 20 },
        "settings": { "$ref": "#/$defs/StudioSettings" },
        "banner": { "anyOf": [{ "$ref": "#/$defs/Banner" }, { "type": "null" }], "default": null },
        "banner_queue": { "type": "array", "items": { "$ref": "#/$defs/Banner" }, "maxItems": 10 },
        "ticker": { "$ref": "#/$defs/Ticker" },
        "countdown": { "anyOf": [{ "$ref": "#/$defs/Countdown" }, { "type": "null" }], "default": null },
        "replay": { "anyOf": [{ "$ref": "#/$defs/Replay" }, { "type": "null" }], "default": null }
      }
    },
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "platform", "url", "enabled", "key_hint", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "platform": { "enum": ["youtube", "x", "facebook", "twitch", "custom", "file"] },
        "url": { "type": "string", "maxLength": 300 },
        "enabled": { "type": "boolean" },
        "key_hint": { "type": "string", "maxLength": 4 },
        "status": { "enum": ["idle", "connecting", "live", "retrying", "failed"] },
        "reason": { "type": ["string", "null"], "default": null },
        "live_since": { "type": ["number", "null"], "default": null }
      }
    },
    "Recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "size_bytes", "made_at"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "maxLength": 80 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "made_at": { "type": "number" }
      }
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "server_time", "destinations", "quality", "state", "recordings"],
      "properties": {
        "revision": { "type": "integer" },
        "server_time": { "type": "number" },
        "destinations": { "type": "array", "items": { "$ref": "#/$defs/Destination" }, "maxItems": 10 },
        "quality": { "enum": ["720p30", "1080p30"] },
        "state": { "enum": ["idle", "starting", "live", "stopping"] },
        "started_at": { "type": ["number", "null"], "default": null },
        "problem": { "type": ["string", "null"], "default": null },
        "recordings": { "type": "array", "items": { "$ref": "#/$defs/Recording" }, "maxItems": 20 }
      }
    },
    "BroadcastDestination": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "platform", "outcome"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "platform": { "enum": ["youtube", "x", "facebook", "twitch", "custom", "file"] },
        "outcome": { "enum": ["off", "live", "failed"] },
        "reason": { "type": ["string", "null"], "default": null }
      }
    },
    "BroadcastSession": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at", "destinations"],
      "properties": {
        "started_at": { "type": "number" },
        "ended_at": { "type": ["number", "null"], "default": null },
        "destinations": { "type": "array", "items": { "$ref": "#/$defs/BroadcastDestination" }, "maxItems": 10 },
        "problem": { "type": ["string", "null"], "default": null }
      }
    },
    "BroadcastRecording": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "size_bytes", "started_at", "made_at"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "maxLength": 80 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "started_at": { "type": "number" },
        "made_at": { "type": "number" }
      }
    },
    "BroadcastMoment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "team", "minute", "at", "score_home", "score_away"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "kind": { "enum": ["goal", "red_card", "big_chance", "momentum_swing", "sustained_pressure"] },
        "team": { "enum": ["home", "away"] },
        "minute": { "type": "integer" },
        "at": { "type": "number" },
        "score_home": { "type": "integer" },
        "score_away": { "type": "integer" },
        "commentary": { "type": ["string", "null"], "default": null }
      }
    },
    "BroadcastScore": {
      "type": "object", "additionalProperties": false,
      "required": ["home", "away", "score_home", "score_away"],
      "properties": {
        "home": { "type": "string" },
        "away": { "type": "string" },
        "score_home": { "type": "integer" },
        "score_away": { "type": "integer" }
      }
    },
    "BroadcastStats": {
      "type": "object", "additionalProperties": false,
      "required": ["live_s"],
      "properties": {
        "live_s": { "type": "number", "minimum": 0 },
        "score": { "anyOf": [{ "$ref": "#/$defs/BroadcastScore" }, { "type": "null" }], "default": null }
      }
    },
    "Reel": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "recording", "start_s", "duration_s", "title", "caption", "hashtags", "state", "agent", "made_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "recording": { "type": "string", "minLength": 1, "maxLength": 80 },
        "moment_id": { "type": ["string", "null"], "default": null },
        "start_s": { "type": "number", "minimum": 0 },
        "duration_s": { "type": "number", "minimum": 0 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "caption": { "type": "string", "maxLength": 300 },
        "hashtags": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
        "state": { "enum": ["rendering", "ready", "failed"] },
        "agent": { "type": "string" },
        "size_bytes": { "type": ["integer", "null"], "default": null },
        "reason": { "type": ["string", "null"], "default": null },
        "made_at": { "type": "number" }
      }
    },
    "Broadcast": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "record", "state", "created_at", "sessions", "recordings", "moments", "stats", "reels", "generating"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "record": { "type": "boolean" },
        "state": { "enum": ["ready", "live", "ended"] },
        "created_at": { "type": "number" },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/BroadcastSession" }, "maxItems": 50 },
        "recordings": { "type": "array", "items": { "$ref": "#/$defs/BroadcastRecording" }, "maxItems": 50 },
        "moments": { "type": "array", "items": { "$ref": "#/$defs/BroadcastMoment" }, "maxItems": 100 },
        "stats": { "$ref": "#/$defs/BroadcastStats" },
        "reels": { "type": "array", "items": { "$ref": "#/$defs/Reel" }, "maxItems": 12 },
        "generating": { "type": "boolean" },
        "problem": { "type": ["string", "null"], "default": null }
      }
    },
    "Broadcasts": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "server_time", "broadcasts", "ai"],
      "properties": {
        "revision": { "type": "integer" },
        "server_time": { "type": "number" },
        "broadcasts": { "type": "array", "items": { "$ref": "#/$defs/Broadcast" }, "maxItems": 100 },
        "current_id": { "type": ["string", "null"], "default": null },
        "ai": { "type": "boolean" }
      }
    }
  }
}
