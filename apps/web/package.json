{
  "name": "@kickstream/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "e2e": "playwright test",
    "e2e:acs": "playwright test --config playwright.acs.config.ts",
    "e2e:network": "playwright test --config playwright.network.config.ts"
  },
  "dependencies": {
    "@azure/communication-calling": "2.0.0",
    "@azure/communication-common": "2.5.0",
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.344",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
